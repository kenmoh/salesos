# SalesOS Environment Configuration
# Copy this to .env and fill in the values

# App
APP_NAME=SalesOS
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=salesos

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Flutterwave
FLW_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLW_SECRET_HASH=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@salesos.ng

# SMS (Termii)
TERMII_API_KEY=

# AI / LLM
AI_GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_API_KEY=

# Web Search (SerpAPI)
SERPAPI_KEY=

# RabbitMQ
RABBIT_MQ_URL=amqp://salesos:salesos@localhost:5672//
