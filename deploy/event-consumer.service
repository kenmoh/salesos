[Unit]
Description=StoreFlow Event Consumer (consumes RabbitMQ -> handlers)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/storeflow
EnvironmentFile=/opt/storeflow/.env
ExecStart=/opt/storeflow/.venv/bin/python -m app.worker.consumer_runner
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
