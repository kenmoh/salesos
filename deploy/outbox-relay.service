[Unit]
Description=StoreFlow Outbox Relay (polls outbox_events -> RabbitMQ)
After=network.target

[Service]
Type=simple
User=salesos
WorkingDirectory=/opt/salesos
EnvironmentFile=/opt/salesos/.env
ExecStartPre=/opt/salesos/.venv/bin/pip install -q -r requirements.txt
ExecStart=/opt/salesos/.venv/bin/python -m app.worker.outbox_runner
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
