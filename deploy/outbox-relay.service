[Unit]
Description=StoreFlow Outbox Relay (polls outbox_events -> RabbitMQ)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/storeflow
EnvironmentFile=/opt/storeflow/.env
ExecStart=/opt/storeflow/.venv/bin/python -m app.worker.outbox_runner
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
