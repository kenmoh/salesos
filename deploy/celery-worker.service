[Unit]
Description=StoreFlow Celery Worker
After=network.target

[Service]
Type=simple
User=salesos
WorkingDirectory=/opt/salesos
EnvironmentFile=/opt/salesos/.env
ExecStartPre=/opt/salesos/.venv/bin/pip install -q -r requirements.txt
ExecStart=/opt/salesos/.venv/bin/celery -A app.worker.celery_app worker \
  --loglevel=info \
  --pool=solo \
  --concurrency=1 \
  --without-mingle \
  --without-gossip \
  --hostname=worker.%h
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
