[Unit]
Description=StoreFlow Celery Beat (scheduled tasks)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/storeflow
EnvironmentFile=/opt/storeflow/.env
ExecStart=/opt/storeflow/.venv/bin/celery -A app.worker.celery_app beat --loglevel=info --hostname=beat.%h
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
